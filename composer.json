{
    "name": "blackcube/dboard",
    "description": "CMS Administration Panel",
    "keywords": [
        "cms",
        "admin",
        "back-office",
        "rbac",
        "oauth2",
        "webauthn"
    ],
    "type": "library",
    "homepage": "https://github.com/blackcubeio/dboard",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Philippe Gaultier",
            "email": "philippe@blackcube.io"
        }
    ],
    "support": {
        "issues": "https://github.com/blackcubeio/dboard/issues",
        "source": "https://github.com/blackcubeio/dboard"
    },
    "readme": "README.md",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "blackcube/bleet": "^1.0",
        "blackcube/dcore": "^1.0",
        "blackcube/fileprovider": "^1.0",
        "blackcube/oauth2": "^1.0",
        "blackcube/resumable": "^1.0",
        "blackcube/assets": "^1.0",
        "blackcube/bridge-form-model": "^1.0",
        "vlucas/phpdotenv": "^5.7",
        "web-auth/webauthn-lib": "^5.3",
        "yiisoft/active-record": "^1.1",
        "yiisoft/aliases": "^3.1",
        "yiisoft/cookies": "^1.2",
        "yiisoft/db": "^2.1",
        "yiisoft/db-migration": "^2.2",
        "yiisoft/db-mysql": "^2.0",
        "yiisoft/rbac": "^2.1",
        "yiisoft/router": "^4.0",
        "yiisoft/router-fastroute": "^4.0",
        "yiisoft/session": "^3.0",
        "yiisoft/strings": "^2.7",
        "yiisoft/translator": "^3.2",
        "yiisoft/translator-message-db": "^1.1",
        "yiisoft/yii-console": "^2.4",
        "yiisoft/yii-view-renderer": "^7.4"
    },
    "suggest": {
        "blackcube/ssr": "Required for SSR route options in Type admin forms"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.3",
        "httpsoft/http-message": "^1.1",
        "yiisoft/di": "^1.4",
        "yiisoft/event-dispatcher": "^1.1",
        "yiisoft/injector": "^1.2",
        "yiisoft/test-support": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Blackcube\\Dboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blackcube\\Dboard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-devel": "1.x-dev"
        },
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        },
        "platform": {
            "php": "8.2"
        }
    }
}
